<% export_config = active_scaffold_config.export %>
<%= as_element :fields_container, class: 'form' do %>
  <%= as_element :form_element, class: 'form-element' do %>
    <%
      columns = export_columns_names(true).visible_columns
      content = active_scaffold_checkbox_list(
        nil,
        columns.map { |column| [column_heading_label(column), column.name] },
        columns.map(&:name).reject { |name| export_config.default_deselected_columns.include?(name) },
        {
          name: 'export_columns',
          id: "#{element_form_id(action: :export)}-columns",
          class: 'columns'
        },
        ui_options: {draggable_lists: export_config.draggable, item_options: {class: 'sortable'}}
      )
    %>
    <%= form_attribute_html(nil, as_(:columns_for_export), content, nil, {}) %>
  <% end %>

  <%= as_element :form_element, class: 'form-element' do %>
    <%
      content = export_options.map do |row_options|
        row_html = row_options.map do |(option, label)|
          as_element(:export_option) do
            label ? content_tag(:label, safe_join([option, label.is_a?(Symbol) ? as_(label) : label], ' ')) : option
          end
        end
        as_element :export_option_row, safe_join(row_html)
      end
    %>
    <%= form_attribute_html(nil, as_(:export_options), safe_join(content), nil, {}) %>
  <% end %>

  <% if export_config.allow_full_download %>
    <%= as_element :form_element, class: 'form-element' do %>
      <%
        content = [
          [radio_button_tag('full_download', false, !export_config.default_full_download), as_(:this_page)],
          [radio_button_tag('full_download', true, export_config.default_full_download), as_(:all_pages)]
        ].map { |option| content_tag(:label, safe_join(option)) }
      %>
      <%= form_attribute_html(nil, as_(:export_pages), safe_join(content), nil, {}) %>
    <% end %>
  <% end %>

  <% if export_config.formats.many? %>
    <%= as_element :form_element, class: 'form-element' do %>
      <%
        content = export_config.formats.map do |format|
          radio = radio_button_tag('format', format, export_config.default_file_format.to_sym == format)
          content_tag(:label, safe_join([radio, format.upcase.to_s]))
        end
      %>
      <%= form_attribute_html(nil, as_(:export_format), safe_join(content), nil, {}) %>
    <% end %>
  <% else %>
    <%= hidden_field_tag('format', export_config.formats[0]) %>
  <% end %>
<% end %>
